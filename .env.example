OLLAMA_URL=http://localhost:11434
MODEL_NAME=gemma:2b
FAISS_INDEX_PATH=./data/embeddings/faiss_index

# Storage laptop: absolute path for Lost & Found SQLite (optional; default backend/app/data/lost_found.sqlite3)
# LOST_FOUND_DB_PATH=/Users/you/Library/Application Support/AirHelp/lost_found.sqlite3

# Offline English TTS: npm run piper:setup  (or: npm run setup, then npm run piper:voices)
# PIPER_VOICE_EN=/full/path/to/custom.onnx
# PIPER_BINARY=/full/path/to/piper
# Optional dev-only tiny English model (never commit piper/ or rhasspy-piper-* trees):
# PIPER_TEST_VOICE_ONNX=/path/to/test_voice.onnx
